---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { site, social, locations } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Header und Footer anzeigen (Dankeseite: nein) */
  chrome?: boolean;
  /** Seitentitel ohne " | Bäckerei Schmitz Werne" */
  rawTitle?: boolean;
  noSitemap?: boolean;
}
const { title, description, chrome = true, rawTitle = false } = Astro.props;
const fullTitle = rawTitle ? title : `${title} | ${site.titleSuffix}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const ogImage = new URL('/og-image.jpg', site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: 'Bäckerei Schmitz',
  alternateName: 'Stadtbäckerei Café Schmitz – Eure Baker Boys',
  url: site.url,
  logo: new URL('/icon-512.png', site.url).href,
  image: ogImage,
  email: site.email,
  telephone: site.phone.tel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressCountry: site.address.country,
  },
  sameAs: [social.facebook, social.instagram],
  department: locations.map((l) => ({
    '@type': 'Bakery',
    name: `Bäckerei Schmitz – ${l.name}`,
    telephone: l.phone.tel,
    address: { '@type': 'PostalAddress', streetAddress: l.address.split(',')[0], postalCode: '59368', addressLocality: 'Werne', addressCountry: 'DE' },
  })),
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/league-spartan-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#325382" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    {chrome && <Header />}
    <main id="main-content">
      <slot />
    </main>
    {chrome && <Footer />}
    <ConsentBanner />
    <script is:inline>
      // Befristete Inhalte (data-visible-until="JJJJ-MM-TT") auch ohne neuen Build pünktlich ausblenden
      (function () {
        var d = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Berlin' });
        document.querySelectorAll('[data-visible-until]').forEach(function (el) {
          if (d > el.getAttribute('data-visible-until')) el.remove();
        });
      })();
    </script>
  </body>
</html>
