---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Split from '../components/Split.astro';
import LocationCards from '../components/LocationCards.astro';
import Gallery from '../components/Gallery.astro';
import Reviews from '../components/Reviews.astro';
import { images } from '../data/images';
import { sections } from '../data/sections';
import { locations, locationsOld, site } from '../data/site';
import { feiertage, isVisible, simjueDienstag } from '../data/announcements';

const s = sections.home;
---
<Base
  title="Bäckerei Schmitz in Werne an der Lippe"
  description="Das Team der Bäckerei Schmitz freut sich auf deinen Besuch in einer unserer Filialen im Herzen von Werne an der Lippe."
>
  {s.hero && (
    <Hero image="heroBroetchenRegal" title="Deine Bäckerei in Werne an der Lippe" text="Das Team der Bäckerei Schmitz freut sich auf dich." pad={200} button={{ text: 'Unsere Standorte', href: '#standorte' }} />
  )}

  {s.simjueDienstag && isVisible(simjueDienstag) && (
    <Split cols={[0, 393, 31, 826]} pad={[30, 30]} class="simjue" label={simjueDienstag.title}>
      <Image slot="a" src={images.aktionSimjueDienstag.src} alt={images.aktionSimjueDienstag.alt} widths={[400, 800]} sizes="(min-width: 768px) 32vw, 92vw" class="simjue__img" />
      <div slot="b">
        <h2 class="t-head t-lg h-mb10">{simjueDienstag.title}</h2>
        <p class="p-l h-mb20">{simjueDienstag.text}</p>
        <a class="btn btn--m h-mb20" href={simjueDienstag.buttonHref} target="_blank" rel="noopener"><span class="btn__label">{simjueDienstag.buttonText}</span></a>
      </div>
    </Split>
  )}

  {s.standorteAlt && <LocationCards items={locationsOld} />}

  {s.feiertage && isVisible(feiertage) && (
    <Split cols={[37, 520, 36, 620]} pad={[23, 100]} class="feiertage" label={feiertage.title}>
      <Image slot="a" src={images.feiertageOeffnungszeiten.src} alt={images.feiertageOeffnungszeiten.alt} widths={[400, 800]} sizes="(min-width: 768px) 42vw, 92vw" class="feiertage__img" />
      <div slot="b">
        <h2 class="t-head t-lg h-mb10">{feiertage.title}</h2>
        <div class="p-m feiertage__txt">{feiertage.lines.map((l) => <p>{l[0]}<br />{l[1]}</p>)}</div>
      </div>
    </Split>
  )}

  {s.standorte && <LocationCards items={locations} id="standorte" />}

  {s.backstubeHautnah && (
    <Split cols={[27, 651, 57, 488]} pad={[70, 120]} class="hautnah" label="Backstube hautnah">
      <Image slot="a" src={images.backstubeKinderBacken.src} alt={images.backstubeKinderBacken.alt} widths={[400, 700, 1000, 1400]} sizes="(min-width: 768px) 52vw, 92vw" class="img-r4 hautnah__img" />
      <div slot="b">
        <p class="p-l h-mb20">Firmenevents, Kindergeburtstage &amp; Hexenhäuschen basteln bei uns in der Backstube.</p>
        <h2 class="t-head t-lg h-mb15">Backstube hautnah: Unser Erlebnisangebot</h2>
        <a class="btn btn--m h-mb20" href={`mailto:${site.email}`}><span class="btn__label">Jetzt per E-Mail anfragen</span></a>
      </div>
    </Split>
  )}

  {s.galerie && (
    <Gallery rows={[
      [['backstubeKinderBacken', 512], ['standortBakerBoys', 416], ['heroBroetchenRegal', 512]],
      [['verkaufswagen', 449], ['standortBackstubeLive', 653], ['lebkuchenhaus', 338]],
    ]} />
  )}

  {s.bestellkarte && (
    <Split cols={[0, 579, 93, 578]} pad={[100, 70]} class="bestell" label="Unsere Bestellkarte">
      <div slot="a">
        <h2 class="t-head t-lg h-mb20">Unsere Bestellkarte</h2>
        <p class="p-l h-mb30">„Mit der Bestellkarte können wir bequem aus dem Betrieb heraus leckere Brötchen und mehr für den nächsten Tag bestellen. Zudem wird alles pünktlich und frisch geliefert.“</p>
        <a class="btn btn--l h-mb10" href="/files/backerei-schmitz-bestellkarte.pdf" target="_blank" rel="noopener"><span class="btn__label">Bestellkarte herunterladen</span><span class="sr-only"> (PDF, 7 MB)</span></a>
      </div>
      <Image slot="b" src={images.bestellkarte.src} alt={images.bestellkarte.alt} widths={[400, 700, 1000, 1400]} sizes="(min-width: 768px) 46vw, 92vw" class="bestell__img" />
    </Split>
  )}

  {s.bastelSets && (
    <Split cols={[29, 451, 119, 622]} pad={[60, 50]} class="sets" label="Unsere Hexenhäuser Bastel-Sets">
      <Image slot="a" src={images.lebkuchenhaus.src} alt={images.lebkuchenhaus.alt} widths={[400, 700, 1000]} sizes="(min-width: 768px) 36vw, 92vw" class="img-r4 sets__img" />
      <div slot="b">
        <h2 class="t-head t-lg h-mb20 sets__title">Unsere Hexenhäuser Bastel-Sets</h2>
        <p class="p-l h-mb20">Für Schulen, Kindergärten, Vereine und viele mehr</p>
        <a class="btn btn--m sets__btn h-mb20" href="/hexenhauser-bastel-sets"><span class="btn__label">Jetzt hier mehr erfahren</span><span class="btn__sub">Oder online direkt anfragen</span></a>
      </div>
    </Split>
  )}

  {s.kundenstimmen && <Reviews />}

  {s.lebensmittelRetten && (
    <section class="retten" aria-labelledby="retten-title">
      <div class="container retten__col">
        <h2 class="t-head t-lg retten__title" id="retten-title">Lebensmittel retten und Menschen in Not unterstützen</h2>
        <p class="p-l retten__text">Unsere Partnerschaften mit der Tafel und Too Good To Go</p>
        <ul class="retten__logos">
          <li><Image src={images.logoTafel.src} alt={images.logoTafel.alt} widths={[400, 800]} sizes="(min-width: 768px) 392px, 149px" /></li>
          <li><Image src={images.logoTooGoodToGo.src} alt={images.logoTooGoodToGo.alt} widths={[400, 800]} sizes="(min-width: 768px) 392px, 149px" /></li>
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .h-mb10 { margin-bottom: 10px; }
  .h-mb15 { margin-bottom: 15px; }
  .h-mb20 { margin-bottom: 20px; }
  .h-mb30 { margin-bottom: 30px; }
  :global(.img-r4) { border-radius: 4px; }

  :global(.hautnah__img) { width: 100%; aspect-ratio: 651 / 417; object-fit: cover; margin-bottom: 10px; }

  :global(.bestell .split__b) { align-self: stretch; }
  :global(.bestell__img) { width: 100%; aspect-ratio: 579 / 538; object-fit: cover; border-radius: 8px; box-shadow: rgba(0, 0, 0, .1) 0 69px 245px 0; margin-bottom: 20px; }
  @media (max-width: 767px) { :global(.bestell__img) { aspect-ratio: 342 / 318; } }

  :global(.sets__img) { width: 100%; aspect-ratio: 451 / 518; object-fit: cover; margin-bottom: 10px; }
  @media (min-width: 768px) { .sets__title { max-width: 436px; } }
  .sets__btn { padding-top: 3px; padding-bottom: 6px; min-height: 61px; }
  @media (max-width: 767px) { .sets__btn { min-height: 64px; } }

  :global(.simjue__img) { width: 100%; border-radius: 16px; }
  :global(.feiertage) { margin: 0 auto; }
  :global(.feiertage__img) { width: 100%; border-radius: 4px; }
  .feiertage__txt { color: rgba(0, 0, 0, .5); display: grid; gap: 20px; }

  .retten { padding: 60px 0 50px; text-align: center; }
  @media (min-width: 768px) { .retten { padding: 120px 0 100px; } }
  @media (min-width: 768px) { .retten__col { max-width: 66.24%; } }
  @media (min-width: 1400px) { .retten__col { max-width: 828px; } }
  .retten__title { max-width: 644px; margin: 0 auto 20px; }
  .retten__text { margin-bottom: 40px; }
  .retten__logos { list-style: none; margin: 0 0 20px; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 44px; }
  .retten__logos :global(img) { width: 100%; aspect-ratio: 392 / 78; object-fit: contain; }
</style>
